# ─────────────────────────────────────────────────────────────
# ARJUN — The Real Trader's Hub · environment configuration
# Copy this file to `.env` and fill in values. NEVER commit `.env`.
# Features whose credentials are missing show a clearly labelled
# "setup required" state in the UI — they never fake a connection.
#
# PRODUCTION (Supabase + host):
#   DATABASE_URL = Supabase POOLED connection (pgBouncer, port 6543)
#   DIRECT_URL   = Supabase DIRECT connection (port 5432, prisma migrate)
#   Then run: ./scripts/deploy.sh supabase-db
# ─────────────────────────────────────────────────────────────

# Core
APP_URL=http://localhost:3000
# Extra trusted origins for CSRF checks (comma-separated) — e.g. a custom domain
# or preview proxy: ALLOWED_ORIGINS=https://app.example.com,https://3000-abc.e2b.app
ALLOWED_ORIGINS=

# Who may embed ARJUN in an <iframe>. Leave EMPTY for the secure default
# (no third-party framing at all). Set to a space-separated list of allowed
# ancestors to permit specific embedders, e.g.:
#   FRAME_ANCESTORS=https://app.example.com https://*.e2b.app
# Set to "*" to allow any embedder (previews / demos only — not for production).
FRAME_ANCESTORS=
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Local:      postgresql://arjun:arjun_dev_password@localhost:5432/arjun
# Supabase:   pooled connection (pgBouncer, port 6543) goes in DATABASE_URL,
#             direct connection (port 5432) goes in DIRECT_URL (used by prisma migrate)
DATABASE_URL=postgresql://arjun:arjun_dev_password@localhost:5432/arjun
DIRECT_URL=postgresql://arjun:arjun_dev_password@localhost:5432/arjun

# Redis (caching, rate limiting, presence)
REDIS_URL=redis://localhost:6379

# Auth secrets — generate with: openssl rand -hex 32
AUTH_SECRET=change-me-generate-a-long-random-string
ENCRYPTION_KEY=change-me-64-hex-chars-for-aes-256-gcm

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Leave empty to disable Google sign-in (email/password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# transactional email (optional — without SMTP, emails are logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ARJUN <no-reply@arjun.local>

# Object storage — "local" writes to ./uploads (default). "s3" requires:
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# Market data provider: "demo" (simulated, clearly labelled) | "twelvedata" | "alphavantage"
MARKET_DATA_PROVIDER=demo
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=

# TradingView Charting Library / Advanced Charts datafeed (optional, licensed)
# The free TradingView widget is used by default and is clearly labelled.
TV_DATAFEED_URL=

# MT5 connector bridge (Expert-Advisor / MetaTrader gateway)
# Point this at a documented bridge service that holds the MT5 terminal
# connection. ARJUN never receives or stores the MT5 master password —
# only the investor (read-only) password, encrypted at rest.
MT5_BRIDGE_URL=
MT5_BRIDGE_API_KEY=

# ARJUN Meet — LiveKit (https://cloud.livekit.io or self-hosted livekit-server)
# Without these, joining a meeting returns an honest "setup required" state
# (503) and the host can still supply an external link (e.g. Google Meet).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─────────────── Realtime transport (messenger, presence, notifications) ───────────────
# auto (default) probes for the in-process Socket.IO server and falls back to
# Supabase Realtime, then to no push at all. The app always boots — it just
# degrades. Set this explicitly when you know your platform:
#   socketio = you run the custom Node server (local, Railway, Render, Fly)
#   supabase = serverless (Vercel) — requires the Supabase vars below
#   none     = disable push entirely
REALTIME_PROVIDER=auto
# Client-side hint for the same choice. NEXT_PUBLIC_* values are inlined into
# the browser bundle, so this is the one the client actually reads.
NEXT_PUBLIC_REALTIME_PROVIDER=auto

# Supabase — free tier covers BOTH Postgres and Realtime.
# NEXT_PUBLIC_* are safe in the browser (protected by row-level security).
# SUPABASE_SERVICE_ROLE_KEY is SERVER ONLY and must never be exposed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the scheduled-jobs endpoint (/api/jobs/run), which replaces
# the in-process job runner on serverless hosts. Generate: openssl rand -hex 32
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Leave empty to disable the endpoint (it will return 503 rather than run).
CRON_SECRET=

# Seed admin (development only)
ADMIN_EMAIL=admin@arjun.local
# Quote values that contain '#' or spaces — dotenv treats an unquoted '#' as a
# comment start (this once silently truncated the seeded admin password).
ADMIN_PASSWORD="change-me-admin-password"
